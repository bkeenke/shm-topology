# Доступ к SHM Topology. Скопируйте в .env и задайте свои пароли.

# Администратор: полный доступ (импорт, правка, удаление). Логин по умолчанию — admin.
ADMIN_LOGIN=admin
ADMIN_PASS=

# Пользователь: только просмотр схем.
USER_LOGIN=
USER_PASS=

# Необязательно: ключ подписи сессий. Если не задан — выводится из паролей
# (смена любого пароля разлогинит всех).
# SESSION_SECRET=
